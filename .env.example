# === Buzón (hola@babilonia.ai) — IMAP para leer, SMTP para enviar (Fase 4) ===
BUZON=hola@babilonia.ai
BABILONIA_ADDRESSES=hola@babilonia.ai
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=hola@babilonia.ai
IMAP_PASSWORD=              # app password
IMAP_CARPETA=INBOX
SMTP_HOST=
SMTP_PORT=587              # 465 = SSL directo; 587/otros = STARTTLS
SMTP_USER=hola@babilonia.ai
SMTP_PASSWORD=
SMTP_REMITENTE=            # default: BUZON (hola@babilonia.ai)
SMTP_NOMBRE=Babilonia

# === Gmail API por OAuth (Plan B para Workspace, si no hay App Password) ===
# Si existe el token (generado con `python -m app.google_oauth_setup`), el sistema usa la
# Gmail API en lugar de IMAP/SMTP. Dejar vacío para usar IMAP/SMTP.
GOOGLE_CREDENTIALS_JSON=   # ruta al client OAuth (default: data/google_credentials.json)
GOOGLE_TOKEN_JSON=        # ruta al token (default: data/google_token.json)
GMAIL_QUERY=is:unread     # qué correos trae el lector Gmail
GMAIL_MAX_POR_CICLO=40    # cuántos correos baja por ciclo (anti rate-limit)
GMAIL_PAUSA_MS=250        # pausa entre requests a Gmail (ms) para no reventar la cuota
GMAIL_MARCAR_LEIDOS=      # vacío = sigue a DRY_RUN (en DRY_RUN no toca la casilla; en vivo marca leídos)

# === Allianz (reglas L1) ===
ALLIANZ_DOMINIOS=allianz.com,allianz.com.mx
ALLIANZ_DEST=             # Directorio Allianz: a dónde se levantan los tickets. Sin esto, 'enviar_a_allianz' queda BLOQUEADA.
ALLIANZ_DIRECTORIO=       # JSON por trámite: {"cambio_conducto_cobro":"cliente.optimax@allianz.com.mx"} (cae a ALLIANZ_DEST)

# === WATI (WhatsApp) — Fase D. Sin credenciales corre en modo laboratorio (no envía). ===
WATI_API_URL=            # p. ej. https://live-server-xxxx.wati.io
WATI_API_TOKEN=
WATI_PLANTILLA_ASESOR=avances   # plantilla de avances (asesores)
WATI_PLANTILLA_CLIENTE=         # plantilla para el cliente (solo cuando se le pide algo)
WATI_PLANTILLA_CECI=            # plantilla para Ceci (intervención / visto bueno)
CECI_WHATSAPP=                  # número de WhatsApp de Ceci (pendiente del equipo)

# === Base de datos: misma Supabase de Tommy, esquema aislado ===
DATABASE_URL=              # postgresql://...
DB_SCHEMA=tickets_allianz

# === Supabase Storage (adjuntos: solo texto+ref en DB) ===
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=tickets-allianz-adjuntos

# === LLM L2 + resúmenes coloquiales (OpenAI, reusado del backend principal) ===
OPENAI_API_KEY=
MODELO_L2=gpt-4.1-mini
USAR_LLM_RESUMEN=true      # false = usa plantillas fijas (sin costo LLM)
# ANTHROPIC_API_KEY=       # opcional, si algún día se prefiere Claude

# === Modo copiloto (primera parte en vivo): resumen interno por correo ===
# Si ponés un correo acá, el bot manda cada RESUMEN_CADA_HORAS un digest de tickets + borradores
# a esa dirección (SOLO interno; no le escribe a Allianz/clientes). Funciona aunque DRY_RUN=true.
RESUMEN_EQUIPO_EMAIL=      # p. ej. ceci@babilonia.ai (vacío = desactivado)
RESUMEN_CADA_HORAS=4

# === Motor ===
DRY_RUN=true               # true = no envía ni purga nada (modo seguro)
UMBRAL_LLM=0.6             # confianza L1 < esto → deriva a L2
POLL_SEGUNDOS=90           # intervalo de polling IMAP del scheduler (Fase 5)
RETENCION_DIAS=180         # el job de retención purga lo más viejo que esto (6 meses)
