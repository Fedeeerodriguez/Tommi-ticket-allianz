# === Buzón (hola@babilonia.ai) — IMAP para leer, SMTP para enviar (Fase 4) ===
BUZON=hola@babilonia.ai
BABILONIA_ADDRESSES=hola@babilonia.ai
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=hola@babilonia.ai
IMAP_PASSWORD=              # app password
IMAP_CARPETA=INBOX
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=hola@babilonia.ai
SMTP_PASSWORD=

# === Allianz (reglas L1) ===
ALLIANZ_DOMINIOS=allianz.com,allianz.com.mx

# === Base de datos: misma Supabase de Tommy, esquema aislado ===
DATABASE_URL=              # postgresql://...
DB_SCHEMA=tickets_allianz

# === Supabase Storage (adjuntos: solo texto+ref en DB) ===
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=tickets-allianz-adjuntos

# === LLM L2 + resúmenes coloquiales (OpenAI, reusado del backend principal) ===
OPENAI_API_KEY=
MODELO_L2=gpt-4.1-mini
USAR_LLM_RESUMEN=true      # false = usa plantillas fijas (sin costo LLM)
# ANTHROPIC_API_KEY=       # opcional, si algún día se prefiere Claude

# === Motor ===
DRY_RUN=true               # true = no envía nada (hasta Fase 4)
UMBRAL_LLM=0.6             # confianza L1 < esto → deriva a L2
POLL_SEGUNDOS=90           # intervalo de polling IMAP
RETENCION_DIAS=180         # purga/compresión cada 6 meses
